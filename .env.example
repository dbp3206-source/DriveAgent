# Sao chép file này thành .env. Không commit .env lên Git.

# Bắt buộc để dùng Gemini. Lấy key tại https://aistudio.google.com/app/apikey
DRIVE_AGENT_GEMINI_API_KEY=
DRIVE_AGENT_GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
DRIVE_AGENT_GEMINI_WEB_RESEARCH_MODEL=gemini-2.5-flash
DRIVE_AGENT_GEMINI_FALLBACK_MODEL=gemini-3.8-flash
DRIVE_AGENT_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# ADK coordinator + bốn agent chuyên trách. Có thể đổi thành langgraph để so sánh.
DRIVE_AGENT_ORCHESTRATOR_BACKEND=adk

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự. Script setup.ps1 có thể tự tạo giúp bạn.
DRIVE_AGENT_APP_SECRET=

# OAuth Google Workspace. Cách dễ nhất là tải JSON từ Google Cloud rồi đặt đường dẫn tại đây.
DRIVE_AGENT_GOOGLE_OAUTH_CLIENT_FILE=./client_secret.json
# Trên cloud, dùng hai secrets này thay vì upload file JSON vào image.
# DRIVE_AGENT_GOOGLE_OAUTH_CLIENT_ID=
# DRIVE_AGENT_GOOGLE_OAUTH_CLIENT_SECRET=
DRIVE_AGENT_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Drive đọc; drive.file chỉ quản lý file app tạo/được chọn; Gmail đọc và gửi có xác nhận.
DRIVE_AGENT_GOOGLE_DRIVE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/calendar.readonly
# Đặt token dài, ngẫu nhiên trước khi cho Prometheus scrape qua mạng production.
DRIVE_AGENT_METRICS_BEARER_TOKEN=
# Token riêng cho Supabase Cron gọi endpoint nội bộ; tối thiểu 32 ký tự trên cloud.
DRIVE_AGENT_SCHEDULER_BEARER_TOKEN=
# Optional pricing snapshot for AgentOps cost estimates. Keep 0 until you set
# the current prices for the configured model; these values are never guessed.
DRIVE_AGENT_GEMINI_INPUT_USD_PER_MILLION=0
DRIVE_AGENT_GEMINI_OUTPUT_USD_PER_MILLION=0

# Local-first. Không cần Docker hoặc dịch vụ ngoài.
DRIVE_AGENT_ENVIRONMENT=development
DRIVE_AGENT_DATABASE_URL=sqlite+aiosqlite:///./data/drive_agent.db
# Cloud uses the same Supabase PostgreSQL project for app data and durable side-state.
# Keep both unset for local. Enter these only as backend secrets on Render.
# DRIVE_AGENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DRIVE_AGENT_RELATIONAL_STATE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DRIVE_AGENT_QDRANT_PATH=./data/qdrant
# Production: đường dẫn tuyệt đối của ổ bền; SQLite DB và Qdrant phải nằm trong đó.
# Chỉ cấu hình đường dẫn không chứng minh ổ thật sự bền: bắt buộc kiểm tra sau restart/redeploy.
# DRIVE_AGENT_STATE_DIR=/absolute/path/to/persistent-volume
# Cloud PDF originals use a private Supabase Storage bucket; service-role keys
# are backend-only and must never be added to frontend variables or committed.
DRIVE_AGENT_STORAGE_BACKEND=local
# DRIVE_AGENT_SUPABASE_URL=https://PROJECT_REF.supabase.co
# DRIVE_AGENT_SUPABASE_SERVICE_ROLE_KEY=
DRIVE_AGENT_SUPABASE_STORAGE_BUCKET=veridra-private
DRIVE_AGENT_FRONTEND_ORIGIN=http://localhost:8000
DRIVE_AGENT_PUBLIC_BASE_URL=http://localhost:8000
# Closed beta: đổi ENVIRONMENT khỏi development/local, cấu hình HTTPS cho ba
# URL public/frontend/OAuth bên trên và mời email cụ thể trước khi khởi động.
# Ở beta, danh sách rỗng, APP_SECRET mặc định/yếu, URL HTTP, demo login và
# quota profile relaxed đều khiến backend từ chối khởi động.
DRIVE_AGENT_BETA_INVITED_EMAILS=
# Email chủ sản phẩm phải thuộc invite list; không dùng người đăng nhập đầu tiên làm admin.
DRIVE_AGENT_BETA_OWNER_EMAIL=
# Mặc định closed beta chỉ đọc và xem trước. Chỉ bật sau quyết định riêng của chủ sản phẩm.
DRIVE_AGENT_BETA_ALLOW_EXTERNAL_WRITES=false
DRIVE_AGENT_BETA_OWNER_DOCUMENT_WRITES=false

# Giới hạn an toàn.
DRIVE_AGENT_MAX_DOWNLOAD_MB=25
# OCR excluded from closed-beta scope; disabled unless explicitly opted in.
DRIVE_AGENT_PDF_OCR_ENABLED=false
# Install trusted Tesseract + Poppler, with both vie and eng traineddata.
DRIVE_AGENT_PDF_TESSERACT_BINARY=
DRIVE_AGENT_PDF_PDFTOPPM_BINARY=
DRIVE_AGENT_PDF_TESSDATA_DIR=
DRIVE_AGENT_TOOL_TIMEOUT_SECONDS=45
DRIVE_AGENT_LOG_LEVEL=INFO

# Chỉ dùng khi phát triển/QA UI, tuyệt đối không bật khi chia sẻ máy hoặc deploy.
DRIVE_AGENT_ENABLE_DEMO_LOGIN=false
